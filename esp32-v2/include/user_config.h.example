#pragma once

// 复制为 user_config.h 后填写。不要把真实 Wi-Fi 密码或令牌提交到公开仓库。
static constexpr char WIFI_SSID[] = "填家里的2.4GHz Wi-Fi名称";
static constexpr char WIFI_PASSWORD[] = "填Wi-Fi密码";

// 电脑上的局域网 IPv4；WebSocket 桥接完成后改成电脑实际地址。
static constexpr char PC_HOST[] = "192.168.1.100";
static constexpr uint16_t PC_PORT = 18765;
static constexpr char PC_WS_PATH[] = "/";
static constexpr char PAIR_TOKEN[] = "替换成电脑端生成的配对令牌";

// 1 = 只跑屏幕演示，可先验证 TFT；0 = 连接 Wi-Fi 和电脑端桥接。
#define DSH_DEMO_MODE 0

// 颜色反相 / 朝向取决于具体 ST7789 小板；颜色看起来不对时切换 true/false。
#define DSH_TFT_INVERTED false

// 截图中的 7 针屏无 CS；BLK 按硬件指南供电，默认不由 GPIO 控制。
// 仅当确认 BLK 是逻辑使能输入、或已经增加背光驱动后，才改为 15。
#define DSH_BACKLIGHT_PIN -1

// INMP441 麦克风增益 1..32；先用回放测试调整，削波时降低。
#define DSH_MIC_GAIN 4
// MAX98357A 软件音量 0..100；首次试听先保持低音量。
#define DSH_SPEAKER_VOLUME 25

// Mirror only the character if the prism reverses its orientation. 0 / 1.
#define DSH_AVATAR_MIRROR 0

// Rotation of the physical panel, in quarter-turns (0 to 3).
#define DSH_TFT_ROTATION 0
// Full image: 0 = direct, 1 = horizontal mirror, 2 = vertical mirror.
#define DSH_SCREEN_MIRROR 0
